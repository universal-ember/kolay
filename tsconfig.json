{
  "extends": "@ember/library-tsconfig",
  "glint": {
    "environment": ["ember-loose", "ember-template-imports"]
  },
  "include": ["src/**/*"],
  "exclude": ["docs-app", "declarations", "src/fake-glint-template.d.ts"],
  "compilerOptions": {
    // Glint doesn't support Array extends.
    // https://github.com/typed-ember/glint/issues/672
    "isolatedModules": true,

    // @tsconfig/node22
    "module": "esnext",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    // My options
    "rootDir": "./src",
    "allowJs": true,
    "checkJs": false, // too hard right -- revisit later
    // dom.iterable is where `Highlight extends Set` and
    // `HighlightRegistry extends Map` are declared — without it, the CSS
    // Custom Highlight API has no add/delete/set (src/browser/services/search)
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "emitDeclarationOnly": true,
    "declarationDir": "declarations",
    "declaration": true,
    // Compat
    "allowSyntheticDefaultImports": true,
    "types": ["ember-source/types", "unplugin", "@glint/ember-tsc/types"]
  }
}
